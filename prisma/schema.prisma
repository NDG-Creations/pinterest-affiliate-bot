generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  NEW
  GENERATED
  READY
  POSTED
  PUBLISHED
  FAILED
}

model Product {
  id              String        @id @default(cuid())
  source          String
  productUrl      String        @unique
  affiliateUrl    String?
  productTitle    String
  productImageUrl String?
  price           String?
  category        String?
  pinTitle        String?
  pinDescription  String?
  pinImageUrl     String?
  pinterestPinId  String?
  status          ProductStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
